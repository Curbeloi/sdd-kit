# AI — Claude Code config and instructions are personal, not shared (see 4f0e750).
# To share project-level config instead, replace `.claude/` with `.claude/*` plus
# `!.claude/settings.json` etc. — but note that `.claude/` ignores the whole
# directory, so git never descends into it and any negation below it is dead.
.claude/
CLAUDE.md

# Eval baselines (timestamped runs — ignore the runs but keep the folder structure)
evals/baselines/chat/*/
# User-provided eval fixtures for image/audio cases. Synthetic text/CSV fixtures are committed.
evals/chat/fixtures/*.jpg
evals/chat/fixtures/*.jpeg
evals/chat/fixtures/*.png
evals/chat/fixtures/*.gif
evals/chat/fixtures/*.webp
evals/chat/fixtures/*.mp3
evals/chat/fixtures/*.wav
evals/chat/fixtures/*.m4a
evals/chat/fixtures/*.ogg
evals/chat/fixtures/*.pdf

